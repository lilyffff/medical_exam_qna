# 실제 토큰·비밀번호는 절대 이 파일에 저장하거나 Git에 올리지 마세요.
# 복사한 뒤 `.env`에만 실제 값을 입력합니다.
HF_TOKEN=

# 기본값: sean0042/KorMedMCQA
KORMED_DATASET_ID=sean0042/KorMedMCQA

# 해설 생성에 쓸 기본 모델 및 (선택) 의료 LoRA 어댑터 경로
MEDICAL_BASE_MODEL=MediKo/MediKo-1.1B-A0.6B-inst
MEDICAL_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
MEDICAL_LORA_ADAPTER=
MEDICAL_TRUST_REMOTE_CODE=true

# 로컬 RAG 전문 의학지식 데이터와 검색 인덱스 경로
MEDICAL_KNOWLEDGE_PATH=medical_knowledge_data
RAG_INDEX_PATH=rag_index.sqlite3

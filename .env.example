# 실제 토큰·비밀번호는 절대 이 파일에 저장하거나 Git에 올리지 마세요.
# 복사한 뒤 `.env`에만 실제 값을 입력합니다.
HF_TOKEN=
OPENAI_API_KEY=

# 기본값: sean0042/KorMedMCQA
KORMED_DATASET_ID=sean0042/KorMedMCQA

# 해설 생성에 쓸 기본 모델 및 (선택) 의료 LoRA 어댑터 경로
MEDICAL_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
MEDICAL_LORA_ADAPTER=
# 사용자 정의 모델 코드를 요구하는 검증된 모델에서만 true로 설정합니다.
MEDICAL_TRUST_REMOTE_CODE=false

# 로컬 RAG 전문 의학지식 데이터와 검색 인덱스 경로
MEDICAL_KNOWLEDGE_PATH=medical_knowledge_data
RAG_INDEX_PATH=rag_index.sqlite3

# 한국어 형태소 + 다국어 임베딩 하이브리드 RAG 검색
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_CONCEPT_PATH=medical_concepts.json
RAG_EMBEDDING_PATH=rag_embeddings.npy
RAG_EMBEDDING_IDS_PATH=rag_embedding_ids.npy
RAG_EMBEDDING_META_PATH=rag_embeddings.meta.json
RAG_EMBEDDING_DEVICE=cpu
RAG_CANDIDATE_LIMIT=100
RAG_EMBEDDING_BATCH_SIZE=64
RAG_EMBEDDING_MAX_LENGTH=256
# 검색 핵심어가 1개만 일치할 때 근거로 인정할 최소 의미 유사도
RAG_GUARDRAIL_MIN_SEMANTIC=0.86

# 같은 Wi-Fi의 모바일 브라우저에서 접속하기 위한 Gradio 서버 설정
# 0.0.0.0은 PC의 모든 네트워크 인터페이스에서 요청을 받습니다.
APP_HOST=0.0.0.0
APP_PORT=7860

# 기관망에서 프록시가 필요할 때만 실제 주소를 입력합니다.
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080
